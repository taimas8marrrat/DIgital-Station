# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Секреты храним только здесь, в Git .env не попадает.
AUTH_SECRET=change-me-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=admin
DISPATCHER_USER=dsp
DISPATCHER_PASSWORD=dsp
POSTGRES_USER=ds
POSTGRES_PASSWORD=ds_secret
POSTGRES_DB=digital_station
# Симуляция: сим-секунд на 1 реальную секунду; частота потока, Гц; старт сим-времени
SIM_SPEED=30
SIM_TICK_HZ=4
SIM_START=2026-10-01T11:20:00
SIM_NOISE=true
SIM_RANDOM_INCIDENTS=false
HISTORY_HOURS=72
LOG_LEVEL=INFO
